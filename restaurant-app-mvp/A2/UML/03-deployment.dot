digraph G { graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.7", ranksep="0.8", label="Restaurant App — Deployment Diagram", labelloc=t, fontsize=18, fontname="Arial"]; node [shape=box, style="rounded,filled", fillcolor="#EAF2F8", color="#17324D", fontname="Arial", fontsize=10, margin="0.18,0.12"]; edge [color="#247BA0", fontname="Arial", fontsize=9]; phone [label="Phone / Emulator\nReact Native + Expo Go"]; laptop [label="Developer Laptop\nNode.js + Express API\nPort 5000"]; db [shape=cylinder, label="MongoDB Atlas\nor local MongoDB", fillcolor="#E8F5E9"]; phone -> laptop [label="HTTP / JSON + JWT\nWi-Fi / LAN"]; laptop -> db [label="Mongoose connection"]; }
